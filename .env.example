# Active SMTP Provider: 'gmail' (for demo / test) or 'titan' (for @srcaa.co.in)
SMTP_PROVIDER=gmail

# ------------------------------------------------------------------------------
# 1. Google Gmail SMTP Configuration (Demo Gateway)
# Server: smtp.gmail.com | Port: 465 (SSL) or 587 (STARTTLS)
# Note: In your Google Account, enable 2-Step Verification and generate a 
# 16-character "App Password" (at https://myaccount.google.com/apppasswords)
# ------------------------------------------------------------------------------
GMAIL_SMTP_HOST=smtp.gmail.com
GMAIL_SMTP_PORT=465
GMAIL_SMTP_SECURE=true
GMAIL_SMTP_USER=abhichannaveerappa@gmail.com
GMAIL_SMTP_PASS=vmfkncfqjljxeegk
GMAIL_FROM_EMAIL=abhichannaveerappa@gmail.com

# ------------------------------------------------------------------------------
# 2. Titan Mail SMTP Configuration
# Server: smtp.titan.email | Port: 465 (SSL) or 587 (STARTTLS)
# ------------------------------------------------------------------------------
TITAN_SMTP_HOST=smtp.titan.email
TITAN_SMTP_PORT=465
TITAN_SMTP_SECURE=true
TITAN_SMTP_USER=admin@srcaa.co.in
TITAN_SMTP_PASS=
TITAN_FROM_EMAIL=admin@srcaa.co.in

# ------------------------------------------------------------------------------
# 3. Editorial Inboxes (Manuscripts and dossiers will be dispatched here)
